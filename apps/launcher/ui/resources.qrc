    <qresource prefix="/">
        <file>qml/Main.qml</file>
        <file>qml/LockScreen.qml</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="notebooks.png">icons/notebooks.png</file>
        <file alias="settings.png">icons/settings.png</file>
        <file alias="store.png">icons/store.png</file>
    </qresource>
</RCC>
